<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <Description>Private ingress proxy for the OpenClawd autonomous merchant fleet. Routes x402.wtf paid challenges, MPP, AP2, A2A, and facilitator traffic behind a confidential edge.</Description>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-PrivateDefaults</Name>
      </Step>
      <Step>
        <Name>EV-VerifyApiKey</Name>
      </Step>
      <Step>
        <Name>JWT-ExtractAgentAssertion</Name>
      </Step>
      <Step>
        <Name>SA-StoreBurstControl</Name>
      </Step>
      <Step>
        <Name>Q-StorePerAppMinute</Name>
      </Step>
    </Request>
    <Response>
      <Step>
        <Name>AM-SanitizeResponse</Name>
      </Step>
    </Response>
  </PreFlow>
  <Flows>
    <Flow name="Health">
      <Condition>(proxy.pathsuffix MatchesPath "/health") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="X402Registry">
      <Description>Public x402.wtf agent registry and merchant registration flows. Forwards signed manifest to x402.wtf/agents/registry.</Description>
      <Condition>(proxy.pathsuffix MatchesPath "/x402/registry") and ((request.verb = "GET") or (request.verb = "POST"))</Condition>
    </Flow>
    <Flow name="X402Payments">
      <Description>Real paid x402 store lane. Forwards paid challenges to https://x402.wtf/payments, validates payment-signature header, and returns 402 challenges to clients.</Description>
      <Condition>(proxy.pathsuffix MatchesPath "/x402/payments/**") and ((request.verb = "GET") or (request.verb = "POST"))</Condition>
    </Flow>
    <Flow name="X402AgentChat">
      <Description>Bridge for x402.wtf agent chat at /api/x402/agent/chat.</Description>
      <Condition>(proxy.pathsuffix MatchesPath "/x402/agent/chat") and (request.verb = "POST")</Condition>
    </Flow>
    <Flow name="X402Agents">
      <Description>Bridge for x402.wtf agents catalog at /api/agents.</Description>
      <Condition>(proxy.pathsuffix MatchesPath "/x402/agents") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="OpenRouterInference">
      <Description>Paid OpenRouter free-model inference lane for metered merchant fulfillment.</Description>
      <Condition>(proxy.pathsuffix MatchesPath "/inference/openrouter/chat") and (request.verb = "POST")</Condition>
    </Flow>
    <Flow name="GrokSwarmInference">
      <Description>Paid xAI Grok swarm text lane for Clawd agent orchestration.</Description>
      <Condition>(proxy.pathsuffix MatchesPath "/inference/xai/chat") and (request.verb = "POST")</Condition>
    </Flow>
    <Flow name="GrokImagineInference">
      <Description>Paid xAI Grok Imagine generation and image edit lane.</Description>
      <Condition>(proxy.pathsuffix MatchesPath "/inference/xai/images/**") and (request.verb = "POST")</Condition>
    </Flow>
    <Flow name="OpenAIFallbackInference">
      <Description>Paid OpenAI fallback fulfillment lane.</Description>
      <Condition>(proxy.pathsuffix MatchesPath "/inference/openai/responses") and (request.verb = "POST")</Condition>
    </Flow>
    <Flow name="Registry">
      <Condition>(proxy.pathsuffix MatchesPath "/registry/**")</Condition>
    </Flow>
    <Flow name="Agents">
      <Condition>(proxy.pathsuffix MatchesPath "/agents/**")</Condition>
    </Flow>
    <Flow name="A2A">
      <Condition>(proxy.pathsuffix MatchesPath "/a2a/**")</Condition>
    </Flow>
    <Flow name="Facilitator">
      <Condition>(proxy.pathsuffix MatchesPath "/facilitator/**")</Condition>
    </Flow>
  </Flows>
  <HTTPProxyConnection>
    <BasePath>/openclawd/private-store</BasePath>
  </HTTPProxyConnection>
  <RouteRule name="route-x402-payments">
    <Condition>proxy.pathsuffix MatchesPath "/x402/payments/**"</Condition>
    <TargetEndpoint>x402-payments</TargetEndpoint>
  </RouteRule>
  <RouteRule name="route-x402-registry">
    <Condition>proxy.pathsuffix MatchesPath "/x402/registry"</Condition>
    <TargetEndpoint>x402-registry</TargetEndpoint>
  </RouteRule>
  <RouteRule name="route-x402-agent-chat">
    <Condition>proxy.pathsuffix MatchesPath "/x402/agent/chat"</Condition>
    <TargetEndpoint>x402-agent-chat</TargetEndpoint>
  </RouteRule>
  <RouteRule name="route-x402-agents">
    <Condition>proxy.pathsuffix MatchesPath "/x402/agents"</Condition>
    <TargetEndpoint>x402-agents</TargetEndpoint>
  </RouteRule>
  <RouteRule name="route-openrouter-chat">
    <Condition>proxy.pathsuffix MatchesPath "/inference/openrouter/chat"</Condition>
    <TargetEndpoint>openrouter-chat</TargetEndpoint>
  </RouteRule>
  <RouteRule name="route-xai-chat">
    <Condition>proxy.pathsuffix MatchesPath "/inference/xai/chat"</Condition>
    <TargetEndpoint>xai-chat</TargetEndpoint>
  </RouteRule>
  <RouteRule name="route-xai-images">
    <Condition>proxy.pathsuffix MatchesPath "/inference/xai/images/**"</Condition>
    <TargetEndpoint>xai-images</TargetEndpoint>
  </RouteRule>
  <RouteRule name="route-openai-responses">
    <Condition>proxy.pathsuffix MatchesPath "/inference/openai/responses"</Condition>
    <TargetEndpoint>openai-responses</TargetEndpoint>
  </RouteRule>
  <RouteRule name="route-default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
  <FaultRules>
    <FaultRule name="unauthorized">
      <Step>
        <Name>RF-Unauthorized</Name>
      </Step>
      <Condition>(fault.name = "FailedToResolveAPIKey") or (fault.name = "ExecutionFailed")</Condition>
    </FaultRule>
    <FaultRule name="x402-challenge-required">
      <Step>
        <Name>RF-X402Challenge</Name>
      </Step>
      <Condition>(proxy.pathsuffix MatchesPath "/x402/payments/**") and (response.status.code = 402)</Condition>
    </FaultRule>
  </FaultRules>
</ProxyEndpoint>
