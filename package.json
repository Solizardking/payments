{
  "name": "openclawd-payments-private",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "list": "node --import tsx/esm index.ts list",
    "manifest": "node --import tsx/esm index.ts manifest",
    "join": "node --import tsx/esm index.ts join",
    "apigee:integrate": "node --import tsx/esm index.ts apigee:integrate",
    "apigee:validate": "node --import tsx/esm index.ts apigee:validate",
    "launch": "bash ./launch.sh",
    "storefront": "npm --prefix storefront run dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --prefix storefront run typecheck && npm --prefix truand run typecheck",
    "check": "npm run manifest && npm run truand:manifest && npm run apigee:integrate && npm run apigee:validate && npm run typecheck",
    "truand:plan": "npm --prefix truand run plan",
    "truand:manifest": "npm --prefix truand run manifest",
    "truand:provision": "npm --prefix truand run provision"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
